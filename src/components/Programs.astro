---
import { apps } from '../data/apps';

const validApps = apps.filter((app) => {
  const ok = Boolean(app?.slug && app?.name);
  if (!ok) console.warn(`[Programs] Skipping app with missing slug/name: ${JSON.stringify(app)}`);
  return ok;
});
---

<section id="programas" class="py-20 scroll-mt-20">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="mb-2">
      <span class="text-xs tracking-widest text-brand-accent font-semibold">PROGRAMAS</span>
    </div>

    <div class="grid md:grid-cols-2 gap-8 mb-12">
      <h2 class="text-3xl md:text-4xl font-bold">Software que construimos.</h2>
      <p class="text-gray-400 text-sm md:text-base">
        Cada programa de GA Software resuelve un problema real de negocio.
      </p>
    </div>

    {validApps.length === 0 ? (
      <p class="text-gray-400">Pronto vas a poder conocer nuestros programas.</p>
    ) : (
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {validApps.map((app) => (
          <article class="bg-brand-card border border-brand-border rounded-2xl p-6 hover:border-brand-accent transition-colors duration-200">
            <span class="inline-block text-xs font-semibold text-brand-accent tracking-widest mb-3">
              {app.category}
            </span>
            <h3 class="text-white text-lg font-bold mb-2">{app.name}</h3>
            <p class="text-gray-400 text-sm">{app.tagline}</p>
          </article>
        ))}
      </div>
    )}
  </div>
</section>
