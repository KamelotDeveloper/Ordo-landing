---
import fs from 'node:fs';
import path from 'node:path';
import { apps, type AppEntry, type Installer } from '../data/apps';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const dir = path.join(process.cwd(), 'public', 'instaladores');
const href = (slug: string, file: string) => `${base}/instaladores/${slug}/${file}`;

function resolve(slug: string, file: string): { available: boolean; size: number | null } {
  try {
    const stat = fs.statSync(path.join(dir, slug, file));
    return stat.isFile()
      ? { available: true, size: stat.size }
      : { available: false, size: null };
  } catch {
    return { available: false, size: null };
  }
}

const sizeText = (n: number | null) =>
  n ? (n >= 1048576 ? `${(n / 1048576).toFixed(1)} MB` : `${Math.ceil(n / 1024)} KB`) : null;

const validApps = apps.filter((app) => {
  const ok = Boolean(app?.slug && app?.name);
  if (!ok) console.warn(`[Downloads] Skipping app with missing slug/name: ${JSON.stringify(app)}`);
  return ok;
});

const rows = (app: AppEntry) =>
  (app.installers ?? []).map((installer: Installer) => {
    const info = resolve(app.slug, installer.file);
    const enabled = app.status === 'available' && info.available;
    const meta = [`v${installer.version}`, sizeText(installer.size ?? info.size)]
      .filter(Boolean)
      .join(' · ');
    return { installer, enabled, meta, url: href(app.slug, installer.file) };
  });
---

<section id="descargas" class="py-20 scroll-mt-20">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="mb-2">
      <span class="text-xs tracking-widest text-brand-accent font-semibold">DESCARGAS</span>
    </div>

    <div class="grid md:grid-cols-2 gap-8 mb-12">
      <h2 class="text-3xl md:text-4xl font-bold">Descargá nuestros programas.</h2>
      <p class="text-gray-400 text-sm md:text-base">
        Instaladores oficiales de cada programa de GA Software.
      </p>
    </div>

    {validApps.length === 0 ? (
      <p class="text-gray-400">Todavía no hay descargas disponibles.</p>
    ) : (
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        {validApps.map((app) => {
          const options = rows(app);
          return (
            <article class="bg-brand-card border border-brand-border rounded-2xl p-6">
              <div class="flex items-baseline justify-between gap-3 mb-2">
                <h3 class="text-white text-lg font-bold">{app.name}</h3>
                <span class="text-xs font-semibold text-brand-accent tracking-widest">{app.category}</span>
              </div>
              <p class="text-gray-400 text-sm mb-5">{app.tagline}</p>
              <ul class="space-y-3">
                {options.length === 0 ? (
                  <li class="flex items-center justify-between gap-4">
                    <span class="text-white text-sm font-medium">{app.name}</span>
                    <button
                      type="button"
                      disabled
                      class="shrink-0 border border-brand-border text-gray-500 rounded-full px-4 py-2 text-xs font-medium cursor-not-allowed"
                    >
                      Próximamente
                    </button>
                  </li>
                ) : (
                  options.map(({ installer, enabled, meta, url }) => (
                    <li class="flex items-center justify-between gap-4">
                      <div class="min-w-0">
                        <span class="block text-white text-sm font-medium">{installer.label}</span>
                        {meta && <span class="block text-gray-500 text-xs">{meta}</span>}
                      </div>
                      {enabled ? (
                        <a
                          href={url}
                          download
                          class="shrink-0 bg-brand-accent text-white rounded-full px-4 py-2 text-xs font-medium hover:opacity-90 transition"
                          aria-label={`Descargar ${app.name} para ${installer.label}`}
                        >
                          Descargar
                        </a>
                      ) : (
                        <button
                          type="button"
                          disabled
                          class="shrink-0 border border-brand-border text-gray-500 rounded-full px-4 py-2 text-xs font-medium cursor-not-allowed"
                          aria-label={`${app.name} para ${installer.label}: próximamente`}
                        >
                          Próximamente
                        </button>
                      )}
                    </li>
                  ))
                )}
              </ul>
            </article>
          );
        })}
      </div>
    )}
  </div>
</section>
